rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // System Administrator check: strictly verified by authorized admin UIDs and admin email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'co8SdsAOxHgJJ6poAyiQQMbETKc2' ||
        request.auth.uid == 'vMSdoIR1wjbwkVLEEmSXMpSMq4z1' ||
        ('email' in request.auth.token && request.auth.token.email == 'yusufabozdemir@gmail.com')
      );
    }

    // --- 1. BUSINESSES COLLECTION ---
    match /businesses/{businessId} {
      // Admin has full CRUD rights
      allow read, write: if isAdmin();

      // Signed in user can self-register their own business upon trial sign-up
      allow create: if isSignedIn();

      // Owner can get and update their registered business
      allow get, update: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid
      );

      // Only admin can list all businesses or delete
      allow list, delete: if isAdmin();
    }

    // --- 2. USERS COLLECTION ---
    match /users/{userId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Users can get, create and update their own profile document
      allow get, create, update: if isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );

      // Only Admin can list all users or delete
      allow list, delete: if isAdmin();
    }

    // --- 3. VEHICLES COLLECTION ---
    match /vehicles/{vehicleId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Authenticated business users can manage vehicles
      allow read, write: if isSignedIn();

      // --- 3.1 STATUS HISTORY SUBCOLLECTION ---
      match /statusHistory/{historyId} {
        allow read, write: if isSignedIn();
      }
    }

    // --- 4. PUBLIC VEHICLES COLLECTION (Müşteri Takip Ekranı) ---
    match /publicVehicles/{publicToken} {
      // Anyone can look up a single vehicle with the unguessable public token without logging in
      allow get: if true;

      // Prevent enumerating or listing all public vehicles (blocks token scraping)
      allow list: if false;

      // Authenticated users can write public tracking records
      allow write: if isSignedIn();
    }
  }
}
