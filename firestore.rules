rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: Block all read and write requests by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // System Administrator check: Strictly enforced by authorized Admin UIDs and Admin Email.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'co8SdsAOxHgJJ6poAyiQQMbETKc2' ||
        request.auth.uid == 'vMSdoIR1wjbwkVLEEmSXMpSMq4z1' ||
        (request.auth.token.email != null && request.auth.token.email == 'yusufabozdemir@gmail.com') ||
        (hasUserDoc() && ('role' in getUserData()) && getUserData().role == 'admin')
      );
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Safely retrieve the validated businessId of the authenticated caller
    function getUserBusinessId() {
      return hasUserDoc() && 
             ('businessId' in getUserData()) && 
             getUserData().businessId is string && 
             getUserData().businessId.size() > 0 
             ? getUserData().businessId : '';
    }

    // --- 1. BUSINESSES COLLECTION ---
    match /businesses/{businessId} {
      // Admin has full CRUD rights
      allow read, write: if isAdmin();

      // Owner can read ONLY their own registered business
      allow get: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid &&
        getUserBusinessId() == businessId
      );

      // Deny owners from listing all businesses (prevents competitor discovery)
      allow list: if isAdmin();

      // Only Admin can provision new businesses
      allow create: if isAdmin();

      // Owner can update their own business, but CANNOT alter ownership or plan fields!
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.ownerUid == request.auth.uid &&
          getUserBusinessId() == businessId &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.plan == resource.data.plan &&
          request.resource.data.active == resource.data.active
        )
      );

      // Only Admin can delete businesses
      allow delete: if isAdmin();
    }

    // --- 2. USERS COLLECTION ---
    match /users/{userId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Users can only view their own user document
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Only Admin can list users or create/delete user accounts
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      // Users can update their profile (e.g. name), but CANNOT change role, businessId, uid, or email!
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.businessId == resource.data.businessId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email
        )
      );
    }

    // --- 3. VEHICLES COLLECTION ---
    match /vehicles/{vehicleId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Owner can get single vehicle ONLY if it belongs to their own business
      allow get: if isSignedIn() && (
        isAdmin() ||
        (
          getUserBusinessId() != '' &&
          resource.data.businessId == getUserBusinessId()
        )
      );

      // Owner can list vehicles ONLY within their own business scope
      allow list: if isSignedIn() && (
        isAdmin() ||
        (
          getUserBusinessId() != '' &&
          resource.data.businessId == getUserBusinessId()
        )
      );

      // Owner can create vehicle ONLY for their own verified businessId
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          getUserBusinessId() != '' &&
          request.resource.data.businessId == getUserBusinessId() &&
          request.resource.data.publicToken is string &&
          request.resource.data.publicToken.size() >= 16
        )
      );

      // Owner can update vehicle details, but CANNOT transfer it to another business or alter publicToken
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          getUserBusinessId() != '' &&
          resource.data.businessId == getUserBusinessId() &&
          request.resource.data.businessId == resource.data.businessId &&
          request.resource.data.publicToken == resource.data.publicToken
        )
      );

      // Owner can delete vehicle ONLY if it belongs to their own business
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (
          getUserBusinessId() != '' &&
          resource.data.businessId == getUserBusinessId()
        )
      );

      // --- 3.1 STATUS HISTORY SUBCOLLECTION ---
      match /statusHistory/{historyId} {
        allow read, write: if isAdmin();

        // Get & List: Only if the parent vehicle belongs to caller's business
        allow get, list: if isSignedIn() && (
          isAdmin() ||
          (
            getUserBusinessId() != '' &&
            get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.businessId == getUserBusinessId()
          )
        );

        // Create: Only for caller's own vehicle, with matching businessId
        allow create: if isSignedIn() && (
          isAdmin() ||
          (
            getUserBusinessId() != '' &&
            get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.businessId == getUserBusinessId() &&
            request.resource.data.businessId == getUserBusinessId()
          )
        );

        // History is an immutable audit log; regular users cannot edit or delete history entries
        allow update, delete: if isAdmin();
      }
    }

    // --- 4. PUBLIC VEHICLES COLLECTION (Müşteri Takip Ekranı) ---
    match /publicVehicles/{publicToken} {
      // Anyone can look up a single vehicle with the unguessable public token without logging in
      allow get: if true;

      // Prevent enumerating or listing all public vehicles (blocks token scraping)
      allow list: if false;

      // Create: only signed-in owner or Admin, strictly forbidding customer PII from being written
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          getUserBusinessId() != '' &&
          request.resource.data.businessId == getUserBusinessId() &&
          !('customerPhone' in request.resource.data) &&
          !('customerName' in request.resource.data) &&
          !('ownerUid' in request.resource.data) &&
          !('email' in request.resource.data)
        )
      );

      // Update: only signed-in owner or Admin, cannot alter businessId or inject private customer PII
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          getUserBusinessId() != '' &&
          resource.data.businessId == getUserBusinessId() &&
          request.resource.data.businessId == resource.data.businessId &&
          !('customerPhone' in request.resource.data) &&
          !('customerName' in request.resource.data) &&
          !('ownerUid' in request.resource.data) &&
          !('email' in request.resource.data)
        )
      );

      // Delete: only vehicle's business owner or Admin
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (
          getUserBusinessId() != '' &&
          resource.data.businessId == getUserBusinessId()
        )
      );
    }
  }
}
