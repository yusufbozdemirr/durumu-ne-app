rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // System Administrator check: strictly verified by authorized admin UIDs and admin email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'co8SdsAOxHgJJ6poAyiQQMbETKc2' ||
        request.auth.uid == 'vMSdoIR1wjbwkVLEEmSXMpSMq4z1' ||
        ('email' in request.auth.token && request.auth.token.email == 'yusufabozdemir@gmail.com')
      );
    }

    // --- 1. BUSINESSES COLLECTION ---
    match /businesses/{businessId} {
      // Admin has full CRUD rights
      allow read, write: if isAdmin();

      // Owner can read their own registered business
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid
      );

      // Only admin can list all businesses
      allow list: if isAdmin();

      // Signed in user can self-register their own business
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0
        )
      );

      // Owner can update their own business details
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid
        )
      );

      // Only Admin can delete businesses
      allow delete: if isAdmin();
    }

    // --- 2. USERS COLLECTION ---
    match /users/{userId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Users can view their own profile
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Only Admin can list all users
      allow list: if isAdmin();
      
      // User can create their own profile upon trial registration
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.uid == request.auth.uid
        )
      );
      
      // User can update their own profile
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.uid == request.auth.uid
        )
      );

      allow delete: if isAdmin();
    }

    // --- 3. VEHICLES COLLECTION ---
    match /vehicles/{vehicleId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Authenticated business users can manage vehicles
      allow read, write: if isSignedIn();

      // --- 3.1 STATUS HISTORY SUBCOLLECTION ---
      match /statusHistory/{historyId} {
        allow read, write: if isSignedIn();
      }
    }

    // --- 4. PUBLIC VEHICLES COLLECTION (Müşteri Takip Ekranı) ---
    match /publicVehicles/{publicToken} {
      // Anyone can look up a single vehicle with the unguessable public token without logging in
      allow get: if true;

      // Prevent enumerating or listing all public vehicles (blocks token scraping)
      allow list: if false;

      // Authenticated users can write public tracking records
      allow write: if isSignedIn();
    }
  }
}
